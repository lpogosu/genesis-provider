# generated artifacts (never committed, regenerated on every run)
/output/

# local secrets
.env
.env.*
!.env.example

# scratch space
/tmp/

# tool state
/.rspec_status
/.bundle/
/vendor/bundle/
/coverage/
*.gem

# документ организаторов — не часть решения
*.docx

# веб-интерфейс: зависимости и сборка. Исходники фронта в репозиторий входят,
# результат сборки — нет: это сгенерированный код, он в подсчёт доли Ruby не
# входит по тексту положения (см. docs/PRINCIPLES.md, «Правила хакатона»).
node_modules/
.next/
space-payments-dashboard/out/
public/
