#!/usr/bin/env ruby
# frozen_string_literal: true

# Поднимает HTTP-API генератора: те же артефакты, что пишет ./integrate,
# только в JSON.
#
#   bin/serve                  0.0.0.0:9292
#   bin/serve --port 3000      другой порт
#   PORT=3000 bin/serve        то же переменной окружения (для образа)
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'specgen'
require 'specgen/web'

require 'optparse'

options = { host: ENV.fetch('HOST', SpecGen::Web::Server::DEFAULT_HOST),
            port: ENV.fetch('PORT', SpecGen::Web::Server::DEFAULT_PORT).to_i }

OptionParser.new do |parser|
  parser.banner = 'Использование: bin/serve [--host HOST] [--port PORT]'
  parser.on('-h', '--host HOST', 'Адрес, который слушать') { |value| options[:host] = value }
  parser.on('-p', '--port PORT', Integer, 'Порт') { |value| options[:port] = value }
  parser.on('--help', 'Эта справка') do
    puts parser
    exit
  end
end.parse!

SpecGen::Web::Server.new(SpecGen::Web.app, **options).start
