#!/usr/bin/env ruby
# frozen_string_literal: true

# Executable entry point. The root-level `./integrate` delegates here so the
# command from the case description works unchanged.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'specgen'
require 'specgen/cli'

SpecGen::CLI.start(ARGV)
