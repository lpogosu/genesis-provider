# <%= t('heading.title', title: provider_title) %>

| | |
|---|---|
| <%= t('head_provider') %> | `<%= provider_slug %>` |
| <%= t('head_spec') %> | <%= t('head_spec_value', file: spec_file, version: spec_version, oas: oas_version) %> |
| <%= t('head_class') %> | `<%= class_name %>` |
| <%= t('head_file') %> | `<%= service_file %>` |

<%= t('prose.intro') %>

## <%= t('heading.summary') %>

<%= table([t('metric_col'), t('value_col')], summary_rows).join("\n") %>

<%= t('prose.artifacts_intro') %>

<%= table([t('file_col'), t('what_col'), t('lines_col')], artifact_rows).join("\n") %>
<%- if overlay -%>

<%= t('overlay_applied', file: overlay.file, title: overlay.title) %>

<%= table([t('overlay_target'), t('overlay_action'), t('overlay_why')], overlay_rows).join("\n") %>
<%- end -%>

### <%= t('heading.checks') %>

<%= t('prose.checks_intro') %>

<%= checks.line %>
<%- checks.groups.each do |group| -%>

**<%= group.title %>** — <%= group.explanation %>

<%= list(group.items).join("\n") %>
<%- unless group.hidden.zero? -%>
- <%= group.more %>
<%- end -%>
<%- end -%>

### <%= t('heading.run') %>

<%= t('prose.run_intro', base_class: base_class) %>

<%= run.line %>
<%- run.groups.each do |group| -%>

**<%= group.title %>** — <%= group.explanation %>

<%= list(group.items).join("\n") %>
<%- unless group.hidden.zero? -%>
- <%= group.more %>
<%- end -%>
<%- end -%>

## <%= t('heading.coverage') %>

<%= t('prose.coverage_line', percent: coverage.percent, covered: coverage.covered, total: coverage.total, in_contract: coverage.in_scope_percent, in_contract_total: coverage.in_scope_total) %>

<%= t('prose.coverage_formula') %>

<%= coverage_scope_note %>

<%- if coverage.out_of_scope.zero? -%>
<%= paragraph(t('coverage_scope_none')) %>
<%- else -%>
<%= coverage_scope_intro %>

<%= coverage_scope_list %>

<%= coverage_scope_rest %>
<%- end -%>

<%= table([t('dimension_col'), t('found_col'), t('covered_col'), t('coverage_col')],
          coverage.dimensions.map { |d| [dimension_name(d), d.total, d.covered, d.percent_text] }).join("\n") %>

### <%= t('heading.gaps') %>

<%- if coverage.gaps.empty? -%>
<%= t('prose.gaps_none') %>
<%- else -%>
<%= coverage_buckets_line %>

<%= coverage_manual_blocks %>

<%= coverage_folded_blocks %>
<%- end -%>

## <%= t('heading.ambiguities') %>

<%= t('prose.ambiguities_intro') %>

<%- if warnings.ambiguities.empty? -%>
<%= t('prose.ambiguities_none') %>
<%- else -%>
<%- warnings.ambiguities.each do |group| -%>
### `<%= group.code %>` — <%= group.total %>

<%= t('prose.group_action', action: group.items.first.action) %>

<%- group.items.each do |item| -%>
- **`<%= item.path %>`** — <%= item.message %>
<%- if item.fix -%>
  <%= item.fix %>
<%- else -%>

  ```yaml
<%= item.overlay.map { |line| "  #{line}" }.join("\n") %>
  ```
<%- end -%>
<%- end -%>
<%- unless group.hidden.zero? -%>
- <%= t('prose.group_more', count: group.hidden) %>
<%- end -%>

<%- end -%>
<%- end -%>
### <%= t('heading.overlay_howto') %>

<%= t('prose.overlay_assemble', provider: provider_slug) %>

```yaml
overlay: 1.0.0
info:
  title: <%= provider_slug %> disambiguation
  version: 1.0.0
actions:
- target: "$..."
  update:
    x-specgen-role: ...
```

```sh
./integrate --spec <%= spec_file %> --provider <%= provider_slug %> --overlay <%= provider_slug %>.overlay.yaml
```

<%= t('prose.overlay_fix') %>

## <%= t('heading.operations') %>

<%= t('prose.operations_intro') %>

<%- if operations.any? -%>
<%= table(operations.headers, operations.rows).join("\n") %>
<%- else -%>
<%= t('prose.operations_none') %>
<%- end -%>

## <%= t('heading.contradictions') %>

<%= t('prose.contradictions_intro') %>

<%- if warnings.contradictions.empty? -%>
<%= t('prose.contradictions_none') %>
<%- else -%>
<%- warnings.contradictions.each do |group| -%>
### `<%= group.code %>` — <%= group.total %>

<%= t('prose.group_action', action: group.items.first.action) %>

<%= list(group.items.map { |item| "**`#{item.path}`** — #{item.message}" }).join("\n") %>
<%- unless group.hidden.zero? -%>
- <%= t('prose.group_more', count: group.hidden) %>
<%- end -%>

<%- end -%>
<%- end -%>
## <%= t('heading.notes') %>

<%= t('prose.notes_intro', limit: notes_limit, spec: spec_file) %>

<%- if warnings.notes.empty? -%>
<%= t('prose.notes_none') %>
<%- else -%>
<%- warnings.notes.each do |group| -%>
**`<%= group.code %>`** — <%= group.total %><%= group.reference ? t('prose.notes_reference', section: group.reference) : '' %>

<%= list(group.items.map { |item| "`#{item.path}` — #{item.message}" }).join("\n") %>
<%- unless group.hidden.zero? -%>
- <%= t('prose.group_more', count: group.hidden) %>
<%- end -%>

<%- end -%>
<%- end -%>
## <%= t('heading.checklist') %>

<%- if checklist.empty? -%>
<%= t('prose.checklist_none') %>
<%- else -%>
<%= numbered(checklist).join("\n") %>

<%= t('prose.checklist_total', total: checklist_total) %>
<%- end -%>
