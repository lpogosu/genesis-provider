<%# Заготовка overlay: OpenAPI Overlay 1.0.0 с одним живым действием-якорем
    и закомментированным слотом на каждую неоднозначность. Разметка (шапка,
    ключи overlay/info/actions) — здесь; все тексты и фрагменты — от
    Skeleton::View, шаблон ничего не решает сам.

    Слоты закомментированы префиксом ровно в два знака: человек снимает его
    и получает готовую строку YAML на той же глубине, что и якорь, поэтому
    список действий остаётся валидным при любом наборе снятых слотов. -%>
<%= comment(header).join("\n") %>
overlay: 1.0.0
info:
  title: <%= title %>
  version: 1.0.0
actions:
<%= anchor.join("\n") %>
<%= comment([''] + intro).join("\n") %>
<%- slots.each do |slot| -%>
#
<%= comment([slot.head] + slot.message + [''] + slot.fragment).join("\n") %>
<%- end -%>
