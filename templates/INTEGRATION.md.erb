# <%= t('heading.title', title: provider_title) %>

| | |
|---|---|
| <%= t('head_provider') %> | `<%= provider_slug %>` |
| <%= t('head_spec') %> | <%= t('head_spec_value', file: spec_file, version: spec_version, oas: oas_version) %> |
| <%= t('head_class') %> | `<%= class_name %> < <%= base_class %>` |
| <%= t('head_file') %> | `<%= service_file %>` |

<%= t('prose.intro') %>

## <%= t('heading.auth') %>

<%- access.auth_lines.each do |line| -%>
<%= line %>

<%- end -%>
<%- unless access.credential_rows.empty? -%>
<%= table([t('cred_key_col'), t('cred_where_col'), t('cred_purpose_col')], access.credential_rows).join("\n") %>

<%- end -%>
<%= t('secret_storage') %>

## <%= t('heading.env') %>

<%= table([t('env_name_col'), t('env_purpose_col'), t('env_default_col'), t('env_required_col')], access.env_rows).join("\n") %>

<%= access.env_notes.join("\n\n") %>

## <%= t('heading.methods') %>

<%= t('prose.methods_intro', base_class: base_class, external_id: external_id) %>

<%= table(methods_section.headers, methods_section.contract_rows).join("\n") %>
<%- unless methods_section.extra_rows.empty? -%>

<%= t('extra_note', base_class: base_class) %>

<%= table(methods_section.headers, methods_section.extra_rows).join("\n") %>
<%- end -%>

## <%= t('heading.statuses') %>

<%- if statuses.status_note -%>
<%= statuses.status_note %>
<%- else -%>
<%= t('prose.status_map_note', approve: helper(:approve_operation), reject: helper(:reject_operation)) %>

<%= table(statuses.headers('status_col'), statuses.status_rows).join("\n") %>
<%- end -%>

<%- if statuses.event_note -%>
<%= statuses.event_note %>
<%- else -%>
<%= t('prose.event_map_note') %>

<%= table(statuses.headers('event_col'), statuses.event_rows).join("\n") %>
<%- end -%>

## <%= t('heading.errors') %>

<%- if errors.any? -%>
<%= t('prose.error_map_note') %>

<%- unless errors.code_rows.empty? -%>
<%= table(errors.code_headers, errors.code_rows).join("\n") %>

<%- end -%>
<%- unless errors.http_rows.empty? -%>
<%= table(errors.http_headers, errors.http_rows).join("\n") %>

<%- end -%>
<%- unless errors.operation_rows.empty? -%>
<%= t('operation_rules_note') %>

<%= table([t('operation_col'), t('http_col'), t('action_col')], errors.operation_rows).join("\n") %>

<%- end -%>
<%= table([t('action_col'), t('action_meaning_col')], errors.action_rows).join("\n") %>
<%- else -%>
<%= t('errors_none', failure: code(helper(:failure)), default: code(errors.default_action)) %>
<%- end -%>

<%= errors.failure_codes_line %>

<%- errors.retry_lines.each do |line| -%>
<%= line %>

<%- end -%>
<%= t('dedup_heading') %> <%= errors.dedup_line %>

## <%= t('heading.gateway') %>

<%= t('gateway_case_note') %>

<%= t('gateway_note', check: code(precheck_method)) %>

<%= fence(gateway.lines, 'yaml').join("\n") %>
<%- if gateway.mapping? -%>

### <%= t('mapping_title') %>

<%= t('mapping_note', hash: code(requisites_hash)) %>

<%= table([t('mapping_field_col'), t('mapping_role_col'), t('mapping_method_col'), t('mapping_expression_col')], gateway.mapping_rows).join("\n") %>
<%- end -%>

## <%= t('heading.signature') %>

<%- if signature.state == :none -%>
<%= signature.note %>
<%- else -%>
<%- if signature.state == :absent -%>
<%= signature.note %>

<%- end -%>
<%= table([t('sig_param_col'), t('sig_value_col'), t('source_col')], signature.rows).join("\n") %>

<%= list(signature.rules_lines).join("\n") %>

<%= t('sig_example') %>

<%= fence(signature.example_lines, 'ruby').join("\n") %>
<%- if signature.state == :absent && signature.overlay -%>

<%= t('sig_overlay') %>

<%= fence(signature.overlay.split("\n"), 'yaml').join("\n") %>
<%- end -%>
<%- end -%>

## <%= t('heading.howto') %>

<%= t('prose.howto', service_file: service_file, base_class: base_class, class_name: class_name, webhook: method_for(:webhook), callback: callback_body, verify: signature_entrypoint, status: method_for(:fetch_status)) %>

## <%= t('heading.assumptions') %>

<%= assumptions.contract_line %>

<%= list(assumptions.project_lines).join("\n") %>

<%= assumptions.platform_line %>

<%= t('run_heading') %>

<%- if run_assumptions.empty? -%>
<%= t('run_none') %>
<%- else -%>
<%= list(run_assumptions.map { |line| "#{line} (#{t('see_report')})" }).join("\n") %>
<%- end -%>
